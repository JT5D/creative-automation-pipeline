{
  "name": "creative-automation-pipeline",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Brief-to-Channel Creative Pipeline \u2014 reuse approved assets, generate only what is missing, produce channel variants deterministically.",
  "scripts": {
    "dev": "concurrently -n server,ui -c cyan,magenta \"npm:dev:server\" \"npm:dev:ui\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:ui": "vite",
    "campaign": "tsx src/cli.ts",
    "make:samples": "tsx scripts/make-sample-assets.ts",
    "doctor": "tsx scripts/doctor.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "lint": "biome check src tests scripts",
    "format": "biome check --write src tests scripts",
    "check": "bash scripts/check.sh",
    "test:baseline": "tsx scripts/baseline.ts",
    "portfolio": "tsx src/cli.ts --all",
    "shots": "tsx scripts/shot-variants.ts",
    "look": "tsx scripts/look.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.4",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.0",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.15"
  }
}
