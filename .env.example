# ─────────────────────────────────────────────────────────────
# GenAI image provider — ONE of these is enough to run the demo.
# ─────────────────────────────────────────────────────────────

# Default provider. Free self-serve key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional Adobe-native path. Requires a Firefly Services entitlement on
# Adobe Developer Console. If both are set, Firefly wins.
FIREFLY_SERVICES_CLIENT_ID=
FIREFLY_SERVICES_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────────
# dev   = a successful generation is cached under .cache/ and reused
#         (labelled GENERATED · CACHED everywhere it appears)
# final = cache bypassed, one real generation per missing hero
MVP_MODE=dev
SERVER_PORT=8787
