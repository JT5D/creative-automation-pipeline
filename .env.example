# ─────────────────────────────────────────────────────────────
# GenAI image provider
# ─────────────────────────────────────────────────────────────
# The pipeline runs with NO key at all - it renders an offline preview,
# labelled as such, which is useful for setup but does NOT satisfy the
# exercise's "generate missing assets with a GenAI image model" requirement.
# One real credential below does.

# A Google AI Studio API key WITH BILLING ENABLED is required for live image
# generation: https://aistudio.google.com/apikey
# Every Gemini image model lists the free tier as "Not available"
# (ai.google.dev/gemini-api/docs/pricing, verified 2026-08-28), so a free-tier
# key returns HTTP 429 with `limit: 0`.
GEMINI_API_KEY=

# Optional Adobe-native path. Requires a Firefly Services entitlement on Adobe
# Developer Console. NOTE: this adapter is written against Adobe's published
# contract but has never been executed - see docs/API_NOTES.md.
FIREFLY_SERVICES_CLIENT_ID=
FIREFLY_SERVICES_CLIENT_SECRET=

# Which provider runs. Required only when BOTH are configured - the code will
# not guess which one should spend money. gemini | firefly
IMAGE_PROVIDER=

# ─────────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────────
# dev   = a successful generation is cached under .cache/ and reused
#         (labelled GENERATED · CACHED everywhere it appears), and the offline
#         preview is allowed when no provider is configured
# final = cache bypassed, one real generation per missing hero, and a missing
#         hero with no real provider FAILS rather than falling back
MVP_MODE=dev
SERVER_PORT=8787
